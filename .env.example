# Core ingestion
RSSAGENT_CSV=Journals.csv
RSSAGENT_DB=journal_tracker.db
RSSAGENT_REQUEST_DELAY=2
RSSAGENT_REQUEST_TIMEOUT=15
RSSAGENT_MAX_ENTRIES=5
RSSAGENT_SCHEDULE_HOURS=6

# Notifications
NOTIFICATION_WEBHOOK_URL=

# LLM router
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
LLM_PROVIDER_ALERT=gemini
LLM_PROVIDER_SYNTHESIZE=gemini
LLM_PROVIDER_GENERATE=bedrock
RSSAGENT_LLM_TIMEOUT=12

# Digestion / generation controls
RSSAGENT_ENABLE_ALERT_DIGESTION=true
RSSAGENT_GENERATE_MIN_NEW_ARTICLES=5
RSSAGENT_GENERATE_DAILY_CAP=3
RSSAGENT_GENERATE_WINDOW_HOURS=24
RSSAGENT_PRIORITY_JOURNALS=
RSSAGENT_CONTENT_ROOT=content

# API / UI integration
RSSAGENT_API_HOST=127.0.0.1
RSSAGENT_API_PORT=8787
NEXT_PUBLIC_RSSAGENT_API_BASE_URL=http://127.0.0.1:8787
